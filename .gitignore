*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- editor / OS ---
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# --- env / secrets ---
.env
.env.local

